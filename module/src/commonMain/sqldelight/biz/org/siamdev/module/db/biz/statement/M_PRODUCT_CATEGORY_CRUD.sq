insert:
INSERT INTO M_PRODUCT_CATEGORY (
    I_CAT_ID, I_CAT_NAME, I_SUBCAT_NAME, I_IS_ACTIVE,
    I_CREATED_AT, I_UPDATED_AT, I_MODIFY_COUNT, I_CREATED_BY, I_UPDATED_BY
) VALUES (
    :catId, :catName, :subcatName, :isActive,
    :createdAt, NULL, 0, :createdBy, NULL
);

update:
UPDATE M_PRODUCT_CATEGORY
SET I_CAT_NAME      = :catName,
    I_SUBCAT_NAME   = :subcatName,
    I_IS_ACTIVE     = :isActive,
    I_UPDATED_AT    = :updatedAt,
    I_MODIFY_COUNT  = I_MODIFY_COUNT + 1,
    I_UPDATED_BY    = :updatedBy
WHERE I_CAT_ID = :catId;

delete:
DELETE FROM M_PRODUCT_CATEGORY WHERE I_CAT_ID = :catId;

selectAll:
SELECT * FROM M_PRODUCT_CATEGORY
WHERE I_IS_ACTIVE = 1
ORDER BY I_CAT_NAME ASC, I_SUBCAT_NAME ASC;

selectById:
SELECT * FROM M_PRODUCT_CATEGORY WHERE I_CAT_ID = :catId;

selectByParentName:
SELECT * FROM M_PRODUCT_CATEGORY
WHERE I_CAT_NAME = :catName AND I_IS_ACTIVE = 1
ORDER BY I_SUBCAT_NAME ASC;

selectDistinctParents:
SELECT DISTINCT I_CAT_NAME FROM M_PRODUCT_CATEGORY
WHERE I_IS_ACTIVE = 1
ORDER BY I_CAT_NAME ASC;