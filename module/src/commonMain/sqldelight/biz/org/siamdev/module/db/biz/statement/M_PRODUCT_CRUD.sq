insert:
INSERT INTO M_PRODUCT (
    I_PRD_ID, I_CAT_ID, I_TAX_ID, I_PRD_KIND,
    I_PRD_NAME, I_PRD_DESC, I_UNIT, I_PRICE, I_COST_PRICE,
    I_CHARGE_VAT, I_OPEN_PRICE, I_SKU, I_BARCODE,
    I_SEND_ORDER_TO, I_DISPLAY_ORDER,
    I_IS_AVAILABLE, I_IS_RECOMMENDED, I_IS_ACTIVE,
    I_CREATED_AT, I_UPDATED_AT, I_MODIFY_COUNT, I_CREATED_BY, I_UPDATED_BY
) VALUES (
    :prdId, :catId, :taxId, :prdKind,
    :prdName, :prdDesc, :unit, :price, :costPrice,
    :chargeVat, :openPrice, :sku, :barcode,
    :sendOrderTo, :displayOrder,
    :isAvailable, :isRecommended, :isActive,
    :createdAt, NULL, 0, :createdBy, NULL
);

update:
UPDATE M_PRODUCT
SET I_CAT_ID          = :catId,
    I_TAX_ID          = :taxId,
    I_PRD_NAME        = :prdName,
    I_PRD_DESC        = :prdDesc,
    I_UNIT            = :unit,
    I_PRICE           = :price,
    I_COST_PRICE      = :costPrice,
    I_CHARGE_VAT      = :chargeVat,
    I_OPEN_PRICE      = :openPrice,
    I_SKU             = :sku,
    I_BARCODE         = :barcode,
    I_SEND_ORDER_TO   = :sendOrderTo,
    I_DISPLAY_ORDER   = :displayOrder,
    I_IS_AVAILABLE    = :isAvailable,
    I_IS_RECOMMENDED  = :isRecommended,
    I_IS_ACTIVE       = :isActive,
    I_UPDATED_AT      = :updatedAt,
    I_MODIFY_COUNT    = I_MODIFY_COUNT + 1,
    I_UPDATED_BY      = :updatedBy
WHERE I_PRD_ID = :prdId;

deactivate:
UPDATE M_PRODUCT
SET I_IS_ACTIVE    = 0,
    I_UPDATED_AT   = :updatedAt,
    I_MODIFY_COUNT = I_MODIFY_COUNT + 1,
    I_UPDATED_BY   = :updatedBy
WHERE I_PRD_ID = :prdId;

setAvailability:
UPDATE M_PRODUCT
SET I_IS_AVAILABLE = :isAvailable,
    I_UPDATED_AT   = :updatedAt,
    I_MODIFY_COUNT = I_MODIFY_COUNT + 1,
    I_UPDATED_BY   = :updatedBy
WHERE I_PRD_ID = :prdId;

delete:
DELETE FROM M_PRODUCT WHERE I_PRD_ID = :prdId;

selectAll:
SELECT * FROM M_PRODUCT
WHERE I_IS_ACTIVE = 1
ORDER BY I_DISPLAY_ORDER ASC, I_PRD_NAME ASC;

selectById:
SELECT * FROM M_PRODUCT WHERE I_PRD_ID = :prdId;

selectByCategory:
SELECT * FROM M_PRODUCT
WHERE I_CAT_ID = :catId AND I_IS_ACTIVE = 1
ORDER BY I_DISPLAY_ORDER ASC, I_PRD_NAME ASC;

selectByKind:
SELECT * FROM M_PRODUCT
WHERE I_PRD_KIND = :prdKind AND I_IS_ACTIVE = 1
ORDER BY I_DISPLAY_ORDER ASC, I_PRD_NAME ASC;

selectAvailable:
SELECT * FROM M_PRODUCT
WHERE I_IS_AVAILABLE = 1 AND I_IS_ACTIVE = 1
ORDER BY I_DISPLAY_ORDER ASC, I_PRD_NAME ASC;

selectRecommended:
SELECT * FROM M_PRODUCT
WHERE I_IS_RECOMMENDED = 1 AND I_IS_AVAILABLE = 1 AND I_IS_ACTIVE = 1
ORDER BY I_DISPLAY_ORDER ASC;

countByCategory:
SELECT COUNT(*) FROM M_PRODUCT
WHERE I_CAT_ID = :catId AND I_IS_ACTIVE = 1;